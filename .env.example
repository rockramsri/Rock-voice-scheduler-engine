# ROCK Scheduler Phase 1 — copy to .env and fill in.
# Lookup order: shell env > this .env > sibling fallbacks
# (../Livekit-agents, ../s2s-experiment) for OPENAI_API_KEY only.

# --- LiveKit Cloud (cloud.livekit.io > your project > Settings > Keys).
#     Needed for `dev` mode/playground and for LiveKit Inference models. ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- OpenAI (platform.openai.com > API keys). Used by the realtime engine,
#     the cascade LLM, and the Pydantic AI work plane. ---
OPENAI_API_KEY=

# --- Optional vendor keys (console.deepgram.com / play.cartesia.ai).
#     Leave EMPTY to route STT/TTS through LiveKit Inference instead —
#     your LiveKit key covers both. ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Engine swap: the whole point of Phase 1. cascade | realtime ---
ENGINE_PROFILE=cascade

# --- Cascade engine models ---
LLM_MODEL=gpt-4.1-mini
# Cartesia sonic-3 voice id; default is a neutral US-English voice
CARTESIA_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# --- Realtime engine models (gpt-realtime-mini = cheap dev option) ---
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# --- Work plane (Pydantic AI) model, "<provider>:<model>" format ---
WORKPLANE_MODEL=openai:gpt-4.1-mini

# --- Data plane (Supabase Postgres). URL + service-role key from the
#     Supabase dashboard > Project Settings > API. The app writes with the
#     service role; the ops console uses the separate publishable/anon key. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dispatch worker poll cadence, in seconds.
WORKER_POLL_SECONDS=2

# --- Observability / PHI posture ---
# LOG_MESSAGE_CONTENT=true records verbatim SMS bodies + callout reasons so the
# ops console can show them (demo default). Set false in production to scrub
# free text and mask phone numbers in the events table.
LOG_MESSAGE_CONTENT=true
# DEBUG_TRANSCRIPTS=true logs raw per-utterance voice transcripts (PHI) to
# stdout. Leave false outside local debugging.
DEBUG_TRANSCRIPTS=false

# --- Channels: Twilio voice (via LiveKit SIP) + SMS ---
# Twilio Console home page > Account Info. Number must be voice+SMS capable
# and attached to an Elastic SIP Trunk pointed at your LiveKit project.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# LiveKit outbound SIP trunk id (ST_...) — `python -m channels.cli status`
# lists them, `provision` creates one from the Twilio trunk settings below.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Only needed by `channels.cli provision` for a fresh outbound trunk:
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# Worker agent name — must match the SIP dispatch rule for inbound calls;
# leave empty for auto-dispatch (console/playground-only development).
AGENT_NAME=
# Inbound SMS webhook: `ngrok http 8787` https URL, then `link-sms` once.
PUBLIC_BASE_URL=
SMS_WEBHOOK_PORT=8787
# WhatsApp sender; default is Twilio's shared sandbox number. Recipients
# join by texting the console's "join <code>" to it first.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TextBelt instant SMS (no A2P wait): "textbelt" = 1 free msg/day;
# buy a key at textbelt.com to lift the cap.
TEXTBELT_KEY=textbelt
