# Copy to evals/.env.eval (gitignored). These point the harness at the
# ISOLATED eval Supabase project — never the production one; seed.py refuses
# to run if this URL matches the prod SUPABASE_URL in the repo .env.
EVAL_SUPABASE_URL=https://<eval-project-ref>.supabase.co
EVAL_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Only used by psql when applying data/schema.sql + data/dashboard.sql.
EVAL_DB_PASSWORD=<db-password>
# Judge: pinned, different family from the gpt-4.1-mini generator.
# The ANTHROPIC_API_KEY itself lives in the repo .env.
JUDGE_MODEL=anthropic:claude-sonnet-4-6
